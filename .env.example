# Copy to .env.local and fill in. Without RESEND_API_KEY the contact form
# returns 501 and tells visitors to email directly.

RESEND_API_KEY=

# Where form submissions land.
# Resend's shared sender (onboarding@resend.dev) only delivers to the address
# that owns the Resend account. To use any other recipient, verify a domain at
# resend.com/domains and set CONTACT_FROM_EMAIL to an address on that domain.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=https://porfolio-web-react.vercel.app
